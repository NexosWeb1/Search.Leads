# Chave da Google Places API (New).
#
# Como obter:
#   1. console.cloud.google.com  ->  criar projeto
#   2. APIs e servicos  ->  ativar "Places API (New)" e "Geocoding API"
#   3. Credenciais  ->  criar chave de API
#   4. Restringir a chave a essas duas APIs
#   5. Ativar o faturamento no projeto (obrigatorio mesmo dentro da cota gratuita)
#
# Cota gratuita mensal relevante aqui: 1.000 requisicoes na SKU Enterprise, que e
# a faixa usada pela busca (por causa dos campos de site e telefone). Cada
# requisicao devolve ate 20 comercios. Acima da cota, USD 35,00 por mil.
GOOGLE_MAPS_API_KEY=

# ---------------------------------------------------------------------------
# Banco: PostgreSQL do Supabase
# ---------------------------------------------------------------------------
#
# Painel do Supabase > Project Settings > Database > Connection string
# Escolha "Transaction pooler" (porta 6543). E o modo indicado para funcao
# serverless, que e como o Netlify roda a aplicacao.
#
# Formato:
#   postgresql://postgres.SEU-REF:SUA-SENHA@aws-N-REGIAO.pooler.supabase.com:6543/postgres
DATABASE_URL=

# ---------------------------------------------------------------------------
# Acesso a plataforma (Supabase Auth)
# ---------------------------------------------------------------------------
#
# Painel do Supabase > Project Settings > API
# Sua conta de acesso e criada em Authentication > Users > Add user.
#
# A chave anonima e publica de proposito: quem protege os dados e a sessao, nao
# o segredo dela. Nunca coloque aqui a chave service_role, que ignora qualquer
# politica de acesso.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
